---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { articlesByDate, articleHref } from '../../data/articles';
---
<BaseLayout
  title="記事一覧 — プランターノート"
  description="プランター菜園の失敗と解決策をまとめた全記事一覧。根腐れ・土の選び方・pH管理・追肥・水やり・防虫ネット・ミニトマト・なす・きゅうり・ピーマン・オクラ・ハーブ・秋野菜まで。"
>
  <h1>📝 記事一覧</h1>
  <p style="margin-top:0.5rem; line-height:1.9; color:var(--color-text-muted); font-size:0.95rem;">
    失敗ノート6冊から生まれた「なぜ失敗したか」「どう解決したか」の記録です。全{articlesByDate.length}記事。
  </p>

  <ul style="list-style:none; padding:0; margin-top:1.4rem; display:grid; gap:1rem;">
    {articlesByDate.map((a) => (
      <li>
        <a href={articleHref(a.slug)} style="display:flex; gap:1rem; align-items:flex-start; background:white; border:1px solid var(--color-border); border-radius:10px; padding:1.1rem 1.2rem; text-decoration:none; color:inherit;">
          <span style="font-size:2rem; line-height:1; flex-shrink:0; margin-top:0.1rem;">{a.emoji}</span>
          <div style="min-width:0;">
            <span style="font-size:0.78rem; font-weight:700; color:var(--color-primary-dark); background:var(--color-bg-card); padding:0.15rem 0.55rem; border-radius:20px; margin-bottom:0.4rem; display:inline-block;">{a.tag}</span>
            <p style="margin:0.3rem 0 0.4rem; font-weight:700; font-size:1rem; color:var(--color-text); line-height:1.45;">{a.cardTitle}</p>
            <p style="margin:0; font-size:0.87rem; line-height:1.75; color:var(--color-text-muted);">{a.desc}</p>
          </div>
        </a>
      </li>
    ))}
  </ul>

  <nav style="margin-top:2.4rem; padding:1rem; border:1px solid var(--color-border); border-radius:8px; font-size:0.9rem; line-height:2;">
    <p style="margin:0 0 0.4rem; font-weight:700; color:var(--color-primary-dark);">商品を探す</p>
    <a href="/category/planter/">プランター</a> ·
    <a href="/category/soil/">土・培養土</a> ·
    <a href="/category/fertilizer/">肥料</a> ·
    <a href="/category/tools/">道具</a> ·
    <a href="/category/pest-control/">害虫対策</a> ·
    <a href="/category/herb/">ハーブ</a> ·
    <a href="/category/tomato/">ミニトマト</a> ·
    <a href="/category/summer-vege/">夏野菜</a>
  </nav>
</BaseLayout>
