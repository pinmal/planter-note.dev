---
import ArticleLayout from '../../layouts/ArticleLayout.astro';

// 福岡県「福岡県野菜主要栽培品種一覧表」（令和7年3月・園芸振興課）の「Ⅰ 品種・作型」の表から、
// は種期・定植期・収穫期・摘要を転記（品種名は省略）。
const th = 'text-align:left; padding:0.6rem; border:1px solid var(--color-border);';
const td = 'padding:0.6rem; border:1px solid var(--color-border); vertical-align:top;';
const tdn = 'padding:0.6rem; border:1px solid var(--color-border); vertical-align:top; white-space:nowrap;';

type R = { type: string; sow: string; plant: string; harvest: string; note: string };
type G = { name: string; slug?: string; rows: R[] };
const groups: G[] = [
  {
    name: 'ダイコン', slug: 'daikon-kabu-sodatekata',
    rows: [
      { type: '秋出', sow: '8月下旬〜9月中旬', plant: '—', harvest: '10月下旬〜12月下旬', note: '' },
      { type: '冬出', sow: '9月中旬〜10月中旬', plant: '—', harvest: '12月下旬〜2月中旬', note: '' },
      { type: '晩出', sow: '9月下旬〜11月中旬', plant: '—', harvest: '1月上旬〜4月上旬', note: 'トンネルまたはハウス栽培（一部品種の露地栽培では、早期抽台に特に注意）' },
      { type: '早春出', sow: '11月中旬〜2月上旬', plant: '—', harvest: '3月上旬〜5月上旬', note: '大型トンネルで保温に努める' },
      { type: '春出', sow: '2月下旬〜3月下旬', plant: '—', harvest: '4月中旬〜6月中旬', note: 'トンネル栽培' },
    ],
  },
  {
    name: 'カブ（小かぶ）', slug: 'daikon-kabu-sodatekata',
    rows: [
      { type: '秋出', sow: '8月上旬〜10月中旬', plant: '—', harvest: '9月上旬〜12月下旬', note: '' },
      { type: '冬出', sow: '10月上旬〜11月下旬', plant: '—', harvest: '12月上旬〜2月下旬', note: 'ハウス栽培' },
      { type: '春出', sow: '12月上旬〜4月上旬', plant: '—', harvest: '3月上旬〜5月上旬', note: 'ハウス栽培、一部トンネル栽培' },
    ],
  },
  {
    name: 'カブ（中かぶ）', slug: 'daikon-kabu-sodatekata',
    rows: [
      { type: '秋出', sow: '8月上旬〜10月上旬', plant: '—', harvest: '10月上旬〜12月下旬', note: '' },
      { type: '冬出', sow: '9月中旬〜10月下旬', plant: '—', harvest: '12月上旬〜3月上旬', note: 'トンネル、マルチ栽培' },
      { type: '春出', sow: '2月上旬〜3月上旬', plant: '—', harvest: '3月中旬〜5月下旬', note: 'トンネル、マルチ栽培' },
    ],
  },
  {
    name: 'ニンジン', slug: 'ninjin-sodatekata',
    rows: [
      { type: '初夏出', sow: '2月上旬〜3月中旬', plant: '—', harvest: '6月', note: '' },
      { type: '冬出', sow: '8月上旬〜9月上旬', plant: '—', harvest: '12月〜1月', note: '' },
      { type: '冬出（加工用）', sow: '8月中旬〜9月上旬', plant: '—', harvest: '12月〜2月', note: '' },
      { type: '春出', sow: '10月下旬〜11月下旬', plant: '—', harvest: '3月下旬〜5月', note: '大型トンネル栽培' },
    ],
  },
  {
    name: 'ホウレンソウ', slug: 'horenso-komatsuna-aki',
    rows: [
      { type: '秋出', sow: '9月中旬〜10月上旬', plant: '—', harvest: '10月下旬〜12月下旬', note: '' },
      { type: '晩出', sow: '10月中旬〜12月上旬', plant: '—', harvest: '1月上旬〜4月上旬', note: '' },
      { type: '初夏出', sow: '2月上旬〜5月下旬', plant: '—', harvest: '4月中旬〜7月上旬', note: '露地及び雨よけ栽培、防虫ネット使用' },
      { type: '夏出', sow: '6月上旬〜7月下旬', plant: '—', harvest: '7月中旬〜8月下旬', note: '雨よけ、遮光栽培、防虫ネット使用。ペーパーポット育苗は本葉2枚時に移植' },
      { type: '早出', sow: '7月上旬〜9月上旬', plant: '—', harvest: '8月上旬〜10月上旬', note: '雨よけ、遮光栽培、防虫ネット使用。ペーパーポット育苗は本葉2枚時に移植' },
    ],
  },
  {
    name: 'タマネギ', slug: 'tamanegi-sodatekata',
    rows: [
      { type: '早出', sow: '9月上旬〜9月中旬', plant: '10月下旬〜11月上旬', harvest: '4月下旬〜5月上旬', note: '' },
      { type: '普通', sow: '9月中旬〜9月下旬', plant: '11月上旬〜11月下旬', harvest: '5月中旬〜6月上旬', note: '' },
      { type: '貯蔵用', sow: '9月下旬', plant: '11月下旬〜12月下旬', harvest: '6月上旬〜6月中旬', note: '' },
    ],
  },
];
---
<ArticleLayout
  title="福岡県の作型表｜ダイコン・カブ・ニンジン・ホウレンソウ・タマネギの種まき時期と収穫期"
  description="福岡県が公開している「野菜主要栽培品種一覧表」の作型表から、ダイコン・カブ・ニンジン・ホウレンソウ・タマネギの種まき時期・植え付け時期・収穫期を抜き出して整理しました。出典つき。"
  slug="fukuoka-sakugata-hyo"
  publishDate="2026-11-05"
  relatedCategory={{ href: '/category/planter/', label: 'プランター' }}
>
  <h1>福岡県の作型表｜ダイコン・カブ・ニンジン・ホウレンソウ・タマネギの種まき時期と収穫期</h1>

  <div style="margin:1rem 0 1.5rem; padding:1rem 1.2rem; background:#f5faf7; border-radius:10px; border:1px solid #c2ddd0;">
    <p style="margin:0 0 0.5rem; font-size:0.84rem; font-weight:700; color:var(--color-primary-dark);">📚 このページで分かること</p>
    <ul style="margin:0; padding-left:1.2rem; font-size:0.9rem; line-height:2.1; color:var(--color-text);">
      <li>5つの野菜の、作型ごとの種まき時期と収穫期</li>
      <li>「作型」とは何か、表の読み方</li>
      <li>この表を家庭のプランターで使うときの注意</li>
    </ul>
  </div>

  <section style="margin-top:1.8rem;">
    <h2>「作型」とは</h2>
    <p style="line-height:1.95;">
      作型は、種をまく時期・育て方・収穫する時期の組み合わせです。
      同じダイコンでも、秋にまいて冬に収穫するもの、冬にまいて春に収穫するもの、というように、いくつもの作型があります。
      福岡県は、県内で作られる主要な野菜73品目について、作型ごとの種まき・植え付け・収穫の時期を表にまとめて公開しています。
      この資料は、野菜づくりを指導するための指針として作られ、原則3年ごとに改訂されます。
    </p>
    <p style="line-height:1.95;">
      ここでは、プランターでも育てやすい5つの野菜を取り上げ、品種名を省いて時期と栽培の摘要だけを並べました。
    </p>
  </section>

  {groups.map((g) => (
    <section style="margin-top:1.8rem;">
      <h2>{g.slug ? <a href={`/articles/${g.slug}/`} style="color:inherit;">{g.name}</a> : g.name}</h2>
      <div style="overflow-x:auto;">
        <table style="width:100%; border-collapse:collapse; font-size:0.88rem; line-height:1.8; min-width:560px;">
          <thead>
            <tr style="background:#eef6f1;">
              <th style={th}>作型</th><th style={th}>種まき</th>
              {g.rows.some((r) => r.plant !== '—') && <th style={th}>植え付け</th>}
              <th style={th}>収穫</th><th style={th}>摘要（栽培のしかた）</th>
            </tr>
          </thead>
          <tbody>
            {g.rows.map((r) => (
              <tr>
                <td style={tdn + ' font-weight:700;'}>{r.type}</td>
                <td style={tdn}>{r.sow}</td>
                {g.rows.some((x) => x.plant !== '—') && <td style={tdn}>{r.plant}</td>}
                <td style={tdn}>{r.harvest}</td>
                <td style={td}>{r.note}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  ))}
  <p style="font-size:0.84rem; color:var(--color-text-muted); line-height:1.8;">
    ※横にスクロールできます。ダイコンとカブは同じ記事に移動します。タマネギは、資料にある「葉たまねぎ」の作型を省いています。
  </p>

  <section style="margin-top:1.8rem;">
    <h2>ニンジンの収穫までの日数（香川県の資料）</h2>
    <p style="line-height:1.95;">
      香川県の農業誌に載った家庭菜園向けの解説（2000年2月号）では、ニンジンの収穫までの日数を、系統ごとに次のように示しています。
    </p>
    <ul style="line-height:2; padding-left:1.2rem;">
      <li>三寸系：発芽後70〜80日（家庭菜園に適し、とう立ちが遅いので春まきに向く系統）</li>
      <li>五寸系：発芽後100日（秋まきに向く系統）</li>
      <li>小型ニンジン：発芽後60〜70日</li>
    </ul>
    <p style="line-height:1.95;">
      同じ解説は、ニンジンはネコブセンチュウに弱く、根にコブがついたら同じ畑での連作を避けるか、土壌消毒が必要だと書いています。
      この資料は20年以上前のもので、品種名などは古い可能性があります。
    </p>
  </section>

  <section style="margin-top:1.8rem;">
    <h2>この表を使うときの注意</h2>
    <ul style="line-height:2; padding-left:1.2rem;">
      <li><strong>福岡県の、農家向けの標準的な作型です。</strong>九州北部の気候を前提にしており、寒い地域では時期が違います。お住まいの地域の目安と合わせて見てください。</li>
      <li><strong>トンネル・ハウス・マルチなどを使う作型が含まれます。</strong>摘要の欄に「トンネル」「ハウス」とある作型は、保温や雨よけの設備を前提にしています。設備のないベランダでは、同じ時期にまいても同じようには育たないことがあります。</li>
      <li><strong>収穫期は、その作型で収穫できる期間の幅です。</strong>種まきの時期が早いほど、収穫の時期も早くなります。</li>
      <li><strong>「—」は、その項目に該当がない（種を直接まく野菜の植え付けなど）という意味です。</strong></li>
    </ul>
    <p style="line-height:1.95;">
      関東地方向けの秋まきの目安は、<a href="/articles/aki-yasai-tanemaki-jiki/">秋まき野菜の種まき時期の早見表</a>を、発芽や育つ間の温度は<a href="/articles/hatsuga-seiiku-tekion-hyo/">発芽適温・生育適温の早見表</a>を見てください。
    </p>
  </section>

  <section style="margin-top:1.8rem;">
    <h2>出典</h2>
    <ul style="line-height:2; padding-left:1.2rem; font-size:0.9rem;">
      <li><a href="https://www.pref.fukuoka.lg.jp/gyosei-shiryo/yasai-syuyousaibai-hinsyu06.html" rel="noopener" target="_blank">福岡県「福岡県野菜主要栽培品種一覧表」（令和7年3月・福岡県農林水産部園芸振興課）</a>：「Ⅰ 品種・作型」の表（PDF）</li>
      <li><a href="https://www.pref.kagawa.lg.jp/documents/27834/3ninjin.pdf" rel="noopener" target="_blank">香川県「ニンジンを作ろう！」（農業香川 2000年2月号）</a>（PDF）</li>
    </ul>
    <p style="font-size:0.84rem; color:var(--color-text-muted); line-height:1.8;">
      このページは、公開されている資料をもとにした一般的な整理です。表の形への並べ替えと文章はプランターノートが行いました。個々の品種・地域・栽培条件で適した時期は変わります。
    </p>
  </section>

  <nav style="margin-top:2rem; padding:1rem; border:1px solid var(--color-border); border-radius:8px; font-size:0.9rem;">
    <p style="margin:0 0 0.4rem; font-weight:700; color:var(--color-primary-dark);">関連記事</p>
    <a href="/articles/fukuoka-sakugata-kyabetsu-hakusai/">福岡県の作型表（キャベツ・ブロッコリー・ハクサイなど）</a><br />
    <a href="/articles/fukuoka-sakugata-lettuce/">福岡県の作型表（レタス・リーフレタス・ロメインレタス）</a><br />
    <a href="/articles/fukuoka-sakugata-negi-nira/">福岡県の作型表（ネギ・ワケギ・ニラ・ニンニクなど）</a><br />
    <a href="/articles/fukuoka-sakugata-tomato-nasu/">福岡県の作型表（トマト・ナス・ピーマンなど）</a><br />
    <a href="/articles/fukuoka-sakugata-kyuuri-kabocha/">福岡県の作型表（キュウリ・スイカ・カボチャ・スイートコーンなど）</a><br />
    <a href="/articles/fukuoka-sakugata-mame-okura/">福岡県の作型表（エダマメ・オクラ・インゲン・ソラマメ・エンドウ）</a><br />
    <a href="/articles/aki-yasai-tanemaki-jiki/">秋まき野菜の種まき時期の早見表</a><br />
    <a href="/articles/hatsuga-seiiku-tekion-hyo/">野菜の発芽適温・生育適温の早見表</a><br />
    <a href="/articles/haru-makikonsai-hikaku/">春まきの根菜（ダイコン・カブ・ニンジン）の比較表</a>
  </nav>
</ArticleLayout>
