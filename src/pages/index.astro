---
import BaseLayout from '../layouts/BaseLayout.astro';

const articles = [
  {
    href: '/articles/negusar-genin/',
    emoji: '🪴',
    tag: 'プランター',
    title: 'プランターで根腐れが起きる原因と対策',
    desc: '失敗ノートに"根腐れ"が32回出てきた。そのうち28回は底穴の問題だった。スリット鉢に変えただけで根腐れはゼロになった話。',
  },
  {
    href: '/articles/tsuchi-erabi/',
    emoji: '🌱',
    tag: '土・培養土',
    title: '格安の土で3年失敗して学んだ、土の選び方',
    desc: '最初の3年間に犯した失敗の半分は、格安の培養土を使い続けたことが根本原因だった。元肥・pH・バーク堆肥の3点で選ぶ。',
  },
  {
    href: '/articles/ph-kanri/',
    emoji: '🔬',
    tag: 'pH管理',
    title: '肥料が効かない原因の28%はpH異常だった',
    desc: '肥料を十分与えているのに葉が黄色くなり続けた。pH計で測ったら5.2。苦土石灰で6.0に戻したら2週間で葉色が回復した話。',
  },
  {
    href: '/articles/bougai-net/',
    emoji: '🛡️',
    tag: '害虫対策',
    title: '防虫ネット1枚でキュウリの収穫が11本→147本になった',
    desc: '農薬ゼロの夏、きゅうりが11本しか収穫できなかった。翌年から防虫ネットを張ったら147本になった。端の密閉だけがコツ。',
  },
  {
    href: '/articles/minitomato-sodatekata/',
    emoji: '🍅',
    tag: 'ミニトマト',
    title: '接ぎ木苗と支柱で収穫量が2倍になった話',
    desc: '普通苗43個 vs 接ぎ木苗91個。同じ条件で2倍以上の差がついた理由と、支柱を定植後2週間以内に立てる理由。',
  },
  {
    href: '/articles/nasu-sodatekata/',
    emoji: '🍆',
    tag: '夏野菜',
    title: 'なすの実がつかない原因——週次追肥記録で解決した方法',
    desc: '収穫が止まるたびに失敗ノートを開くと「追肥を飛ばした週」がある。週次追肥の習慣を作ってから1株68個収穫できた。',
  },
];

const categories = [
  { href: '/category/planter/',      emoji: '🪴', label: 'プランター' },
  { href: '/category/soil/',         emoji: '🌱', label: '土・培養土' },
  { href: '/category/fertilizer/',   emoji: '💊', label: '肥料' },
  { href: '/category/tools/',        emoji: '🔧', label: '道具' },
  { href: '/category/pest-control/', emoji: '🛡️', label: '害虫・病気対策' },
  { href: '/category/herb/',         emoji: '🌿', label: 'ハーブ' },
  { href: '/category/tomato/',       emoji: '🍅', label: 'ミニトマト' },
  { href: '/category/summer-vege/',  emoji: '🥒', label: '夏野菜' },
];
---
<BaseLayout
  title="プランターノート — 失敗ノートから学ぶ家庭菜園の記録"
  description="千葉在住・品質管理30年の増田博之が、12年の菜園歴と失敗ノート6冊から書くプランター菜園の記録。根腐れ・pH・追肥の失敗と解決策。"
>

  <!-- ─── キャラクター注記 -->
  <p style="font-size:0.78rem; color:var(--color-text-muted); line-height:1.7; margin:0 0 1rem; padding:0.5rem 0.8rem; background:var(--color-bg-card); border-radius:6px; border-left:3px solid var(--color-border);">
    ※「増田博之」は架空のキャラクターです。取材にもとづく実用情報を、日記形式のエピソードでお届けしています。
    <a href="/privacy-policy/" style="color:var(--color-primary-dark);">詳しくはこちら</a>
  </p>

  <!-- ─── ヒーロー -->
  <section class="hero-section">
    <p class="hero-lead">失敗を記録して、<br />次に活かす菜園ノート</p>
    <p style="font-size:0.95rem; line-height:1.95; margin:0 0 1rem; color:var(--color-text-muted);">
      千葉のベランダと市民農園で12年、失敗ノートを書き続けています。
      品質管理部門に30年いたせいで、失敗すると「原因は何か」から考えてしまう。
      そこで気づいたことと、使ってよかった道具を記録しています。
    </p>
    <div class="hero-badges">
      <span class="hero-badge">🌱 菜園歴12年</span>
      <span class="hero-badge">📔 失敗ノート6冊</span>
      <span class="hero-badge">🔬 品質管理思考</span>
    </div>
  </section>

  <!-- ─── 記事一覧 -->
  <section style="margin-top:2rem;">
    <h2 style="margin-bottom:1rem;">失敗ノートの記録</h2>
    <div style="display:grid; gap:1rem;">
      {articles.map((a) => (
        <a href={a.href} style="display:flex; gap:1rem; align-items:flex-start; background:white; border:1px solid var(--color-border); border-radius:12px; padding:1.1rem 1.2rem; text-decoration:none; color:inherit;">
          <span style="font-size:2rem; line-height:1; flex-shrink:0; margin-top:0.1rem;">{a.emoji}</span>
          <div style="min-width:0;">
            <span style="font-size:0.75rem; font-weight:700; color:var(--color-primary-dark); background:var(--color-bg-card); padding:0.12rem 0.5rem; border-radius:20px; display:inline-block; margin-bottom:0.35rem;">{a.tag}</span>
            <p style="margin:0 0 0.3rem; font-weight:700; font-size:1rem; color:var(--color-text); line-height:1.45;">{a.title}</p>
            <p style="margin:0; font-size:0.86rem; line-height:1.75; color:var(--color-text-muted);">{a.desc}</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- ─── アイテムカテゴリ -->
  <section style="margin-top:2.8rem;">
    <h2 style="margin-bottom:0.6rem;">アイテムを探す</h2>
    <p style="font-size:0.88rem; color:var(--color-text-muted); margin-bottom:1rem; line-height:1.7;">
      記事の中で紹介しているアイテムはカテゴリページにまとめています。
    </p>
    <div class="category-grid">
      {categories.map((c) => (
        <a href={c.href} class="card" style="text-decoration:none; color:inherit; display:flex; align-items:center; gap:0.6rem; padding:0.9rem 1rem;">
          <span style="font-size:1.5rem; flex-shrink:0;">{c.emoji}</span>
          <span style="font-weight:700; font-size:0.93rem;">{c.label}</span>
        </a>
      ))}
    </div>
  </section>

  <!-- ─── Kindle 読者向けバナー -->
  <section style="margin-top:2.8rem; padding:1.2rem 1.3rem; border:1px solid #2d6a4f; border-radius:12px; background:#f4fbf7;">
    <p style="font-size:0.78rem; color:#2d6a4f; font-weight:700; margin:0 0 0.3rem; letter-spacing:0.05em;">Kindle本をお読みの方へ</p>
    <p style="font-weight:700; margin:0 0 0.5rem; font-size:0.97rem;">本の中で紹介したアイテムをまとめました</p>
    <p style="margin:0 0 0.8rem; font-size:0.88rem; line-height:1.75; color:var(--color-text-muted);">
      「どこで買えばいいの？」に答えるページを用意しています。
    </p>
    <a href="/kindle-guide/" style="display:inline-block; background:#2d6a4f; color:white; padding:0.55rem 1.3rem; border-radius:7px; text-decoration:none; font-weight:700; font-size:0.9rem;">
      → 本をお読みの方へ
    </a>
  </section>

</BaseLayout>
