---
import BaseLayout from './BaseLayout.astro';
import DisclosureBanner from '../components/DisclosureBanner.astro';
import { relatedArticles, articleHref } from '../data/articles';

interface Props {
  title: string;
  description: string;
  slug: string;
  publishDate?: string;
  relatedCategory?: { href: string; label: string };
  prevArticle?: { href: string; title: string };
  nextArticle?: { href: string; title: string };
}
const { title, description, slug, publishDate, relatedCategory, prevArticle, nextArticle } = Astro.props;

// 全16記事の正本 src/data/articles.ts から関連記事を選ぶ
// （旧実装は9記事のハードコード配列で、7記事が関連枠に一度も出なかった）
const otherArticles = relatedArticles(slug, 3);
const SITE_URL = 'https://planter-note.pages.dev';

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  author: {
    '@type': 'Organization',
    name: 'プランターノート編集部',
  },
  publisher: {
    '@type': 'Organization',
    name: 'プランターノート',
    url: `${SITE_URL}/`,
  },
  url: `${SITE_URL}/articles/${slug}/`,
  ...(publishDate ? { datePublished: publishDate, dateModified: publishDate } : {}),
  inLanguage: 'ja',
};

// 視覚的パンくずに対応する構造化データ（従来は JSON-LD 化されていなかった）
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'ホーム', item: `${SITE_URL}/` },
    { '@type': 'ListItem', position: 2, name: '記事一覧', item: `${SITE_URL}/articles/` },
    { '@type': 'ListItem', position: 3, name: title, item: `${SITE_URL}/articles/${slug}/` },
  ],
};
---
<BaseLayout title={title} description={description} ogType="article" canonical={`${SITE_URL}/articles/${slug}/`}>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <!-- パンくず -->
  <nav aria-label="パンくず" style="font-size:0.82rem; color:var(--color-text-muted); margin-bottom:1rem;">
    <a href="/" style="color:var(--color-primary-dark);">ホーム</a>
    <span style="margin:0 0.4rem;">›</span>
    <a href="/articles/" style="color:var(--color-primary-dark);">記事一覧</a>
    <span style="margin:0 0.4rem;">›</span>
    <span>{title}</span>
  </nav>

  <DisclosureBanner />

  <article style="margin-top:1rem;">
    <slot />
  </article>

  <!-- 関連カテゴリ -->
  {relatedCategory && (
    <nav style="margin-top:2.4rem; padding:1rem; border:1px solid var(--color-border); border-radius:8px; font-size:0.9rem;">
      <p style="margin:0 0 0.4rem; font-weight:700; color:var(--color-primary-dark);">関連カテゴリ</p>
      <a href={relatedCategory.href}>{relatedCategory.label} — おすすめ商品一覧</a>
    </nav>
  )}

  <!-- 他の記事も読まれています -->
  {otherArticles.length > 0 && (
    <section style="margin-top:2.4rem;">
      <h2 style="font-size:1rem; margin-bottom:0.8rem; color:var(--color-text-muted);">他の記事も読まれています</h2>
      <div style="display:grid; gap:0.55rem;">
        {otherArticles.map((a) => (
          <a href={articleHref(a.slug)} style="display:flex; gap:0.8rem; align-items:center; background:white; border:1px solid var(--color-border); border-radius:9px; padding:0.7rem 1rem; text-decoration:none; color:inherit;">
            <span style="font-size:1.3rem; flex-shrink:0;">{a.emoji}</span>
            <span style="font-size:0.9rem; font-weight:700; color:var(--color-text); line-height:1.4;">{a.cardTitle}</span>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- 前後記事ナビ -->
  {(prevArticle || nextArticle) && (
    <nav aria-label="前後記事" style="margin-top:2rem; display:flex; gap:0.8rem; font-size:0.88rem; flex-wrap:wrap;">
      {prevArticle ? (
        <a href={prevArticle.href} style="flex:1; min-width:200px; padding:0.75rem 1rem; border:1px solid var(--color-border); border-radius:9px; color:var(--color-primary-dark); text-decoration:none; display:block; background:white;">
          <span style="font-size:0.76rem; color:var(--color-text-muted); display:block; margin-bottom:0.25rem;">← 前の記事</span>
          {prevArticle.title}
        </a>
      ) : <div style="flex:1; min-width:200px;" />}
      {nextArticle ? (
        <a href={nextArticle.href} style="flex:1; min-width:200px; padding:0.75rem 1rem; border:1px solid var(--color-border); border-radius:9px; color:var(--color-primary-dark); text-decoration:none; display:block; text-align:right; background:white;">
          <span style="font-size:0.76rem; color:var(--color-text-muted); display:block; margin-bottom:0.25rem;">次の記事 →</span>
          {nextArticle.title}
        </a>
      ) : <div style="flex:1; min-width:200px;" />}
    </nav>
  )}

  <!-- 記事一覧に戻る -->
  <p style="margin-top:1.2rem; font-size:0.9rem;">
    <a href="/articles/" style="color:var(--color-primary-dark);">← 記事一覧に戻る</a>
  </p>
</BaseLayout>
